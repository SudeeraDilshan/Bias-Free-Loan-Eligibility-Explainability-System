# API Configuration
API_TITLE=Bias-Free Loan Eligibility System
API_VERSION=1.0.0
API_DESCRIPTION=XAI-powered loan eligibility prediction with fairness analysis

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=True

# JWT
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=sqlite:///./app.db
# For PostgreSQL: postgresql://user:password@localhost/dbname

# Model Configuration
MODEL_PATH=../ml/models/xgboost_model.joblib
SCALER_PATH=../ml/models/scaler.joblib
PREPROCESSOR_PATH=../ml/models/preprocessor.joblib

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
